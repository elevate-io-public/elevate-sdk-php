{
    "name": "elevate-io/elevate-sdk-php",
    "description": "elevate.io SDK for PHP",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-openssl": "*"
    },
    "autoload": {
        "psr-4": {
            "Elevate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Elevate\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "style": "php-cs-fixer check --diff",
        "style-fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^12.5"
    }
}
