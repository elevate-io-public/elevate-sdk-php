{
    "name": "elevate-io/elevate-sdk-php",
    "description": "elevate.io SDK for PHP",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-openssl": "*",
        "firebase/php-jwt": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Elevate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Elevate\\Tests\\": "tests/",
            "Elevate\\SystemTests\\": "system_tests/",
            "Elevate\\Generator\\": "generator/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "style": "php-cs-fixer check --diff",
        "style-fix": "php-cs-fixer fix",
        "generate": "php bin/generate.php",
        "sync-spec": [
            "curl --fail --silent --show-error \"$ELEVATE_SPEC_URL\" --output openapi/openapi-spec.yaml",
            "@generate"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "league/openapi-psr7-validator": "^0.24",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^12.5",
        "symfony/yaml": "^7.2"
    }
}
